# Copy to .env and fill in. Never commit the real .env.

# LLM — answer generation and the grounding judge.
# Free tier, no card required: https://console.groq.com/keys
GROQ_API_KEY=

# Embeddings — used when the embedding provider is set to "gemini".
# Free tier, no card required: https://aistudio.google.com/app/apikey
# Not needed when running the local MiniLM embedding path.
GEMINI_API_KEY=

# Which embedding provider to use: "local" or "gemini".
#
# Leave unset (defaults to "local") for local development and the demo
# recording: MiniLM runs on the CPU with no quota and no network.
#
# Set to "gemini" for the deployed app. Embedding then runs on Google's
# servers and costs the container almost nothing, which is what leaves room
# under Streamlit Community Cloud's ~1 GB memory ceiling for the local
# cross-encoder reranker. Measured footprint of the deployed stack with this
# set to "gemini": 654 MiB.
#
# Switching providers changes the vector width, so the index on disk has to be
# rebuilt after a change. The app detects the mismatch and says so rather than
# failing mid-query.
# EMBEDDING_PROVIDER=gemini
